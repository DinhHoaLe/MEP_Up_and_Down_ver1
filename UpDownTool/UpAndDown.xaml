<Window x:Class="MEP_Up_and_Down.UpDownTool.UpAndDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MEP_Up_and_Down.UpDownTool"
             mc:Ignorable="d" 
                Height="420"
        Width="300"
        Title="MEP Up And Down"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        >
    <Grid>
        <TabControl x:Name = "tabControl" HorizontalAlignment="Left" VerticalAlignment="Top" >
            <TabItem Header="Duct" Width="80">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
            <TabItem Header="Pipe" Width="80">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
            <TabItem Header="Cable Tray" Width="80">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
        </TabControl>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 30 0 0">
            <GroupBox Header="Setting" Width="280" Height="100" BorderBrush="Gray">
                <StackPanel Margin="0 10 0 0">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Option" Width="60" />
                        <ComboBox x:Name="cbbOption" Width="200" SelectionChanged="cbbOption_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                        <Label Content="Angle" Width="50" />
                        <ComboBox x:Name="cbbAngle" Width="60" SelectionChanged="cbbAngle_SelectionChanged"/>
                        <Label Content="Offset(mm)" Width="70" />
                        <TextBox x:Name="tbOffset" Width="80" HorizontalContentAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Image" BorderBrush="Gray" Width="280"  Height="185">
                <Image x:Name="img" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" />
            </GroupBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Height="25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0 0 5 10">
            <Button x:Name="btnOk" Width="80" Content="Ok" Margin="0 0 5 0" Click="btnOk_Click" />
            <Button x:Name="btnCancel" Width="80" Content="Cancel" Margin="0 0 5 0" Click="btnCancel_Click" />
        </StackPanel>

    </Grid>
</Window>
